{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:verifiable-pro:api:chat-v1",
  "title": "verifiable.pro chat API v1",
  "description": "JSON payloads of the chat API described in api/chat-v1.md: GET /v1/meta, GET /v1/attestation, POST /v1/chat (request body and server-sent event payloads), error bodies, and the client-computed VerificationResult. Reference a definition as chat-v1.schema.json#/$defs/<Name>. Unknown properties are allowed everywhere: clients and servers must ignore fields they do not know.",
  "$comment": "Keywords used: $ref (local #/$defs only), allOf, anyOf, type, enum, const, required, properties, items, minItems, maxItems, minLength, pattern, minimum, maximum, plus annotations. backend/mock/test_server.py validates fixtures and live mock output with a stdlib validator that implements exactly this subset and rejects any other keyword.",
  "$defs": {
    "Hex64": {
      "description": "32 bytes as 64 lowercase hex characters (SHA-256 digests, nonces).",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "Hex64OrNull": {
      "anyOf": [{ "$ref": "#/$defs/Hex64" }, { "type": "null" }]
    },
    "ImageDigestOrNull": {
      "anyOf": [{ "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, { "type": "null" }]
    },
    "Timestamp": {
      "description": "RFC 3339 timestamp in UTC.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "TimestampOrNull": {
      "anyOf": [{ "$ref": "#/$defs/Timestamp" }, { "type": "null" }]
    },
    "B64u32": {
      "description": "32 bytes, base64url without padding.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "StringOrNull": { "type": ["string", "null"] },
    "Lang": { "enum": ["en", "zh"] },
    "Mode": {
      "description": "mock = phase 0 (nothing attested); managed = phase 1 provider behind a ciphertext-only proxy; self_hosted = phase 2 confidential VM.",
      "enum": ["mock", "managed", "self_hosted"]
    },

    "Meta": {
      "description": "GET /v1/meta.",
      "type": "object",
      "required": ["api_version", "mode", "backend", "encryption", "attestation_required", "models", "limits", "status"],
      "properties": {
        "api_version": { "const": "1" },
        "mode": { "$ref": "#/$defs/Mode" },
        "backend": {
          "type": "object",
          "required": ["id", "label"],
          "properties": {
            "id": { "type": "string", "minLength": 1, "examples": ["mock-local", "tinfoil", "vp-gcp-cs-1"] },
            "label": { "type": "string", "minLength": 1 }
          }
        },
        "encryption": { "description": "\"none\" in phase 0; \"ehbp-v1\" from phase 1.", "enum": ["none", "ehbp-v1"] },
        "attestation_required": { "type": "boolean", "description": "false only in mock mode." },
        "models": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "display", "langs"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "display": { "type": "string", "minLength": 1 },
              "langs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Lang" } }
            }
          }
        },
        "limits": { "$ref": "#/$defs/Limits" },
        "privacy_url": { "$ref": "#/$defs/StringOrNull" },
        "status": { "enum": ["ok", "degraded", "offline"] },
        "system_prompt_sha256": {
          "description": "Extension: SHA-256 of the public system prompt (UTF-8), or null when no prompt is used (the extractive mock).",
          "$ref": "#/$defs/Hex64OrNull"
        },
        "notice": { "description": "Extension: human-readable warning, e.g. the mock's 'nothing is attested'.", "type": "string" }
      }
    },
    "Limits": {
      "type": "object",
      "required": ["max_question_chars", "max_turns", "max_context_chunks", "max_input_tokens", "max_output_tokens", "requests_per_10min"],
      "properties": {
        "max_question_chars": { "type": "integer", "minimum": 1 },
        "max_turns": { "type": "integer", "minimum": 1, "description": "Maximum user messages per request; messages may hold at most 2 x max_turns entries." },
        "max_context_chunks": { "type": "integer", "minimum": 0 },
        "max_input_tokens": { "type": "integer", "minimum": 1 },
        "max_output_tokens": { "type": "integer", "minimum": 1 },
        "requests_per_10min": { "type": "integer", "minimum": 1 },
        "max_body_bytes": { "type": "integer", "minimum": 1, "description": "Extension: largest accepted request body." }
      }
    },

    "AttestationBundle": {
      "description": "GET /v1/attestation?nonce=<64 hex>.",
      "type": "object",
      "required": ["schema", "attestation_id", "mode", "nonce", "issued_at", "expires_at", "keyset", "keyset_digest", "binding", "evidence", "collateral", "release", "server_checks", "summary", "report_url"],
      "properties": {
        "schema": { "const": "verifiable.pro/attestation/v1" },
        "attestation_id": { "type": "string", "minLength": 1, "description": "Opaque; sent back as VP-Attestation-Id." },
        "mode": { "$ref": "#/$defs/Mode" },
        "nonce": { "$ref": "#/$defs/Hex64" },
        "issued_at": { "$ref": "#/$defs/Timestamp" },
        "expires_at": { "$ref": "#/$defs/Timestamp" },
        "keyset": { "$ref": "#/$defs/Keyset" },
        "keyset_digest": {
          "description": "hex(sha256(\"vp-keyset/v1\\n\" || JCS(keyset))), JCS = RFC 8785.",
          "$ref": "#/$defs/Hex64"
        },
        "binding": { "$ref": "#/$defs/Binding" },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/Evidence" } },
        "collateral": { "type": "array", "items": { "$ref": "#/$defs/Collateral" } },
        "release": { "anyOf": [{ "$ref": "#/$defs/Release" }, { "type": "null" }] },
        "server_checks": { "type": "array", "items": { "$ref": "#/$defs/ServerCheck" } },
        "summary": { "$ref": "#/$defs/AttestationSummary" },
        "report_url": { "$ref": "#/$defs/StringOrNull" },
        "notice": { "type": "string", "description": "Extension: human-readable warning." },
        "example": { "type": "boolean", "description": "true only in documentation fixtures; a running backend never sends it." }
      }
    },
    "Keyset": {
      "type": "object",
      "required": ["epoch", "hpke", "receipt", "tls_spki_sha256", "release"],
      "properties": {
        "epoch": { "$ref": "#/$defs/Timestamp" },
        "hpke": {
          "description": "null when meta.encryption is \"none\" (phase 0).",
          "anyOf": [
            {
              "type": "object",
              "required": ["kem", "kdf", "aead", "public_key"],
              "properties": {
                "kem": { "const": "DHKEM(X25519,HKDF-SHA256)" },
                "kdf": { "const": "HKDF-SHA256" },
                "aead": { "const": "AES-256-GCM" },
                "public_key": { "$ref": "#/$defs/B64u32" }
              }
            },
            { "type": "null" }
          ]
        },
        "receipt": {
          "anyOf": [
            {
              "type": "object",
              "required": ["alg", "public_key"],
              "properties": { "alg": { "const": "Ed25519" }, "public_key": { "$ref": "#/$defs/B64u32" } }
            },
            { "type": "null" }
          ]
        },
        "tls_spki_sha256": { "$ref": "#/$defs/Hex64OrNull" },
        "release": {
          "anyOf": [
            {
              "type": "object",
              "required": ["repo", "tag", "commit"],
              "properties": {
                "repo": { "type": "string" },
                "tag": { "type": "string" },
                "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
              }
            },
            { "type": "null" }
          ]
        }
      }
    },
    "Binding": {
      "type": "object",
      "required": ["method", "description", "gpu_nonce"],
      "properties": {
        "method": { "enum": ["tdx-report-data-split-v1", "snp-report-data-split-v1", "gcp-cs-eat-nonce-v1", "provider", "none"] },
        "description": { "type": "string" },
        "gpu_nonce": {
          "description": "hex(sha256(nonce_bytes || keyset_digest_bytes)), or null.",
          "$ref": "#/$defs/Hex64OrNull"
        }
      }
    },
    "Evidence": {
      "type": "object",
      "required": ["kind", "format"],
      "properties": {
        "kind": { "enum": ["tdx_quote", "snp_report", "gcp_cs_token", "nvidia_eat", "nvidia_evidence", "provider_bundle"] },
        "format": { "type": "string" },
        "data": { "description": "b64u bytes, a JWT, or JSON, depending on format." },
        "url": { "type": "string" },
        "vcek_url": { "type": "string" },
        "cached": { "type": "boolean", "description": "nvidia_eat: true when a cached EAT (not bound to this nonce) is served." },
        "provider": { "type": "string" }
      }
    },
    "Collateral": {
      "description": "Vendor-signed material relayed for in-browser checks (Intel PCS TCB info and CRLs, AMD VCEK, NRAS signing key with its x5c chain).",
      "type": "object",
      "required": ["kind", "data"],
      "properties": {
        "kind": { "type": "string", "examples": ["intel_pcs_tcb_info", "intel_pcs_crl", "intel_qe_identity", "amd_vcek", "nvidia_nras_jwk"] },
        "data": {}
      }
    },
    "Release": {
      "type": "object",
      "required": ["release_json_url", "sigstore_bundle", "expected"],
      "properties": {
        "release_json_url": { "$ref": "#/$defs/StringOrNull" },
        "sigstore_bundle": { "description": "Inline Sigstore bundle (JSON object or string), or null." },
        "expected": {
          "type": "object",
          "required": ["image_digest", "model_digest", "system_prompt_sha256", "gpu_policy_sha256"],
          "properties": {
            "image_digest": { "$ref": "#/$defs/ImageDigestOrNull" },
            "model_digest": { "$ref": "#/$defs/Hex64OrNull" },
            "system_prompt_sha256": { "$ref": "#/$defs/Hex64OrNull" },
            "gpu_policy_sha256": { "$ref": "#/$defs/Hex64OrNull" }
          }
        }
      }
    },
    "ServerCheck": {
      "description": "Reported by the backend's measured code. Never drives the badge by itself.",
      "type": "object",
      "required": ["id", "result"],
      "properties": {
        "id": { "type": "string" },
        "result": { "enum": ["pass", "fail", "skipped"] },
        "at": { "$ref": "#/$defs/Timestamp" },
        "detail": { "type": "string" }
      }
    },
    "AttestationSummary": {
      "description": "Display object: server claims. The client replaces each claim it can check with its own result.",
      "type": "object",
      "required": ["tee", "gpu", "cc_mode", "model", "model_digest", "image_digest", "measurement", "code", "system_prompt_sha256", "corpus", "verified_by", "verified_at", "report_url", "nonce", "claims"],
      "properties": {
        "tee": {
          "type": "object",
          "required": ["cpu", "label", "platform"],
          "properties": {
            "cpu": { "enum": ["intel-tdx", "amd-sev-snp", "none"] },
            "label": { "type": "string" },
            "platform": { "enum": ["gcp-confidential-space", "azure-ncc-h100-v5", "dstack", "tinfoil", "privatemode", "mock"] },
            "tcb_status": { "$ref": "#/$defs/StringOrNull" },
            "debug": { "type": ["boolean", "null"] }
          }
        },
        "gpu": {
          "anyOf": [
            {
              "type": "object",
              "required": ["vendor", "model", "arch", "count"],
              "properties": {
                "vendor": { "const": "nvidia" },
                "model": { "type": "string" },
                "arch": { "enum": ["hopper", "blackwell"] },
                "count": { "type": "integer", "minimum": 1 },
                "driver_version": { "$ref": "#/$defs/StringOrNull" },
                "vbios_version": { "$ref": "#/$defs/StringOrNull" }
              }
            },
            { "type": "null" }
          ]
        },
        "cc_mode": { "enum": ["on", "devtools", "off", "ppcie", "unknown"] },
        "model": {
          "type": "object",
          "required": ["id", "display"],
          "properties": {
            "id": { "type": "string" },
            "revision": { "$ref": "#/$defs/StringOrNull" },
            "license": { "$ref": "#/$defs/StringOrNull" },
            "engine": { "$ref": "#/$defs/StringOrNull" },
            "display": { "type": "string" }
          }
        },
        "model_digest": { "$ref": "#/$defs/Hex64OrNull" },
        "image_digest": { "$ref": "#/$defs/ImageDigestOrNull" },
        "measurement": {
          "anyOf": [
            {
              "type": "object",
              "required": ["type", "mrtd", "rtmr"],
              "properties": {
                "type": { "const": "tdx" },
                "mrtd": { "type": "string", "pattern": "^[0-9a-f]{96}$" },
                "rtmr": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "string", "pattern": "^[0-9a-f]{96}$" } },
                "mr_config_id": { "type": "string", "pattern": "^[0-9a-f]{96}$" }
              }
            },
            {
              "type": "object",
              "required": ["type", "launch_measurement"],
              "properties": { "type": { "const": "sev-snp" }, "launch_measurement": { "type": "string", "pattern": "^[0-9a-f]{96}$" } }
            },
            {
              "type": "object",
              "required": ["type", "swname", "image_digest"],
              "properties": {
                "type": { "const": "gcp-cs" },
                "swname": { "const": "CONFIDENTIAL_SPACE" },
                "image_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
              }
            },
            { "type": "null" }
          ]
        },
        "code": {
          "anyOf": [
            {
              "type": "object",
              "required": ["repo", "tag", "commit"],
              "properties": {
                "repo": { "type": "string" },
                "tag": { "type": "string" },
                "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
                "release_url": { "type": "string" }
              }
            },
            { "type": "null" }
          ]
        },
        "system_prompt_sha256": { "$ref": "#/$defs/Hex64OrNull" },
        "corpus": {
          "anyOf": [
            {
              "type": "object",
              "required": ["manifest_digest", "manifest_url"],
              "properties": { "manifest_digest": { "$ref": "#/$defs/Hex64OrNull" }, "manifest_url": { "$ref": "#/$defs/StringOrNull" } }
            },
            { "type": "null" }
          ]
        },
        "verified_by": {
          "description": "Which parties' signatures stand behind the claims. Empty in mock mode.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["party", "subject"],
            "properties": {
              "party": {
                "anyOf": [
                  { "enum": ["google-cloud-attestation", "intel-trust-authority", "nvidia-nras", "browser"] },
                  { "type": "string", "pattern": "^provider:[a-z0-9-]+$" }
                ]
              },
              "subject": { "enum": ["cpu", "gpu", "release"] },
              "issuer": { "type": "string" }
            }
          }
        },
        "verified_at": { "$ref": "#/$defs/TimestampOrNull" },
        "report_url": { "$ref": "#/$defs/StringOrNull" },
        "nonce": { "$ref": "#/$defs/Hex64" },
        "claims": {
          "type": "object",
          "required": ["operator_can_read_plaintext", "basis"],
          "properties": { "operator_can_read_plaintext": { "type": "boolean" }, "basis": { "type": "string" } }
        }
      }
    },
    "MockAttestationBundle": {
      "description": "What a phase-0 mock must return: nothing attested, nothing claimed.",
      "allOf": [
        { "$ref": "#/$defs/AttestationBundle" },
        {
          "type": "object",
          "required": ["notice"],
          "properties": {
            "mode": { "const": "mock" },
            "keyset": {
              "type": "object",
              "properties": { "hpke": { "type": "null" }, "receipt": { "type": "null" }, "tls_spki_sha256": { "type": "null" }, "release": { "type": "null" } }
            },
            "binding": { "type": "object", "properties": { "method": { "const": "none" }, "gpu_nonce": { "type": "null" } } },
            "evidence": { "type": "array", "maxItems": 0 },
            "collateral": { "type": "array", "maxItems": 0 },
            "release": { "type": "null" },
            "server_checks": { "type": "array", "maxItems": 0 },
            "summary": {
              "type": "object",
              "properties": {
                "tee": { "type": "object", "properties": { "cpu": { "const": "none" }, "platform": { "const": "mock" } } },
                "gpu": { "type": "null" },
                "cc_mode": { "const": "off" },
                "model_digest": { "type": "null" },
                "image_digest": { "type": "null" },
                "measurement": { "type": "null" },
                "code": { "type": "null" },
                "verified_by": { "type": "array", "maxItems": 0 },
                "verified_at": { "type": "null" },
                "claims": { "type": "object", "properties": { "operator_can_read_plaintext": { "const": true } } }
              }
            },
            "example": { "const": false }
          }
        }
      ]
    },
    "ExampleAttestationBundle": {
      "description": "Documentation fixture with realistic but fake values. Must carry example: true; never served by a backend.",
      "allOf": [
        { "$ref": "#/$defs/AttestationBundle" },
        { "type": "object", "required": ["example"], "properties": { "example": { "const": true } } }
      ]
    },

    "ChatRequest": {
      "description": "POST /v1/chat plaintext body (in phase 1+ the same bytes are EHBP-encrypted).",
      "type": "object",
      "required": ["api_version", "lang", "nonce", "messages", "context"],
      "properties": {
        "api_version": { "const": "1" },
        "lang": { "$ref": "#/$defs/Lang" },
        "nonce": { "description": "The nonce sent to GET /v1/attestation.", "$ref": "#/$defs/Hex64" },
        "page": {
          "anyOf": [
            {
              "type": "object",
              "required": ["path"],
              "properties": { "path": { "type": "string" }, "source_sha256": { "$ref": "#/$defs/Hex64OrNull" } }
            },
            { "type": "null" }
          ]
        },
        "messages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["role", "content"],
            "properties": { "role": { "enum": ["user", "assistant"] }, "content": { "type": "string", "minLength": 1 } }
          }
        },
        "context": {
          "type": "object",
          "required": ["manifest_digest", "chunks"],
          "properties": {
            "manifest_digest": { "$ref": "#/$defs/Hex64OrNull" },
            "chunks": { "type": "array", "items": { "$ref": "#/$defs/Chunk" } }
          }
        },
        "options": {
          "type": "object",
          "properties": {
            "max_output_tokens": { "type": "integer", "minimum": 1 },
            "temperature": { "type": "number", "minimum": 0, "maximum": 2 }
          }
        }
      }
    },
    "Chunk": {
      "description": "A passage the browser selected from the site's published data.",
      "type": "object",
      "required": ["n", "id", "title", "url", "text"],
      "properties": {
        "n": { "type": "integer", "minimum": 1, "description": "Citation number; unique within the request." },
        "id": { "type": "string" },
        "slug": { "$ref": "#/$defs/StringOrNull" },
        "lang": { "anyOf": [{ "$ref": "#/$defs/Lang" }, { "type": "null" }] },
        "kind": { "$ref": "#/$defs/StringOrNull" },
        "title": { "type": "string" },
        "heading": { "$ref": "#/$defs/StringOrNull" },
        "url": { "type": "string", "description": "Canonical site path, e.g. /articles/<slug>/#<anchor>." },
        "source": { "$ref": "#/$defs/StringOrNull", "description": "Published source path listed in /manifest.json, e.g. /articles/<slug>/en.md." },
        "source_sha256": { "$ref": "#/$defs/Hex64OrNull" },
        "start": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }], "description": "Offset into the decoded source, in UTF-16 code units (JavaScript string index); null when the text is not a verbatim slice." },
        "end": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }], "description": "Exclusive end offset, same unit as start." },
        "text": { "type": "string" }
      }
    },

    "EventMeta": {
      "type": "object",
      "required": ["request_id", "backend", "model", "attestation_id", "keyset_digest", "started_at"],
      "properties": {
        "request_id": { "type": "string" },
        "backend": { "type": "string" },
        "mode": { "$ref": "#/$defs/Mode" },
        "model": { "type": "string" },
        "attestation_id": { "$ref": "#/$defs/StringOrNull" },
        "keyset_digest": { "$ref": "#/$defs/Hex64OrNull" },
        "started_at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "EventCitations": {
      "type": "object",
      "required": ["items"],
      "properties": { "items": { "type": "array", "items": { "$ref": "#/$defs/Citation" } } }
    },
    "Citation": {
      "type": "object",
      "required": ["n", "chunk_id", "title", "url", "context_verified"],
      "properties": {
        "n": { "type": "integer", "minimum": 1 },
        "chunk_id": { "type": "string" },
        "title": { "type": "string" },
        "heading": { "$ref": "#/$defs/StringOrNull" },
        "url": { "type": "string" },
        "lang": { "anyOf": [{ "$ref": "#/$defs/Lang" }, { "type": "null" }] },
        "source": { "$ref": "#/$defs/StringOrNull" },
        "source_sha256": { "$ref": "#/$defs/Hex64OrNull" },
        "start": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
        "end": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
        "context_verified": { "type": "boolean", "description": "true only when the backend checked the chunk against its own copy of the corpus (phase 2)." }
      }
    },
    "EventDelta": {
      "type": "object",
      "required": ["i", "text"],
      "properties": { "i": { "type": "integer", "minimum": 0 }, "text": { "type": "string" } }
    },
    "EventNotice": {
      "type": "object",
      "required": ["code", "message"],
      "properties": { "code": { "type": "string", "examples": ["context_truncated"] }, "message": { "type": "string" } }
    },
    "EventDone": {
      "type": "object",
      "required": ["finish_reason", "used_citations", "receipt"],
      "properties": {
        "finish_reason": { "enum": ["stop", "length", "refused"] },
        "used_citations": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
        "usage": {
          "anyOf": [
            {
              "type": "object",
              "required": ["input_tokens", "output_tokens"],
              "properties": {
                "input_tokens": { "type": "integer", "minimum": 0 },
                "output_tokens": { "type": "integer", "minimum": 0 },
                "estimated": { "type": "boolean", "description": "Extension: true when the counts are estimates." }
              }
            },
            { "type": "null" }
          ]
        },
        "receipt": { "anyOf": [{ "$ref": "#/$defs/Receipt" }, { "type": "null" }] }
      }
    },
    "Receipt": {
      "description": "Phase 2. Signature over the LF-joined canonical string in api/chat-v1.md.",
      "type": "object",
      "required": ["version", "alg", "request_sha256", "response_sha256", "model_digest", "image_digest", "system_prompt_sha256", "corpus_manifest_digest", "keyset_digest", "nonce", "issued_at", "signature"],
      "properties": {
        "version": { "const": "vp-receipt/v1" },
        "alg": { "const": "Ed25519" },
        "request_sha256": { "$ref": "#/$defs/Hex64" },
        "response_sha256": { "$ref": "#/$defs/Hex64" },
        "model_digest": { "$ref": "#/$defs/Hex64" },
        "image_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "system_prompt_sha256": { "$ref": "#/$defs/Hex64" },
        "corpus_manifest_digest": { "$ref": "#/$defs/Hex64" },
        "keyset_digest": { "$ref": "#/$defs/Hex64" },
        "nonce": { "$ref": "#/$defs/Hex64" },
        "issued_at": { "$ref": "#/$defs/Timestamp" },
        "signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" }
      }
    },
    "ErrorCode": {
      "enum": ["rate_limited", "attestation_expired", "attestation_mismatch", "bad_request", "too_long", "upstream_unavailable", "internal", "not_found", "method_not_allowed", "origin_not_allowed"]
    },
    "ErrorDetail": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "$ref": "#/$defs/ErrorCode" },
        "message": { "type": "string" },
        "retry_after_s": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] }
      }
    },
    "EventError": {
      "description": "SSE error event; the stream ends after it (no done event).",
      "$ref": "#/$defs/ErrorDetail"
    },
    "ErrorResponse": {
      "description": "Body of every non-2xx JSON response.",
      "type": "object",
      "required": ["error"],
      "properties": { "error": { "$ref": "#/$defs/ErrorDetail" } }
    },

    "VerificationResult": {
      "description": "Computed by the browser and rendered by the widget. The server never sends it.",
      "type": "object",
      "required": ["overall", "checked_at", "verifier", "checks", "still_trusted"],
      "properties": {
        "overall": {
          "description": "demo: mock or in-browser demo; reported: server claims shown, nothing checked in the browser; partly_verified: some checks ran in the browser, some were skipped; verified: every check passed in the browser (never drawn as a green tick); failed: a check failed.",
          "enum": ["demo", "reported", "partly_verified", "verified", "failed"]
        },
        "checked_at": { "$ref": "#/$defs/Timestamp" },
        "verifier": {
          "type": "object",
          "required": ["name", "version"],
          "properties": { "name": { "type": "string" }, "version": { "type": "string" }, "script_sha256": { "$ref": "#/$defs/Hex64OrNull" } }
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "status"],
            "properties": {
              "id": {
                "type": "string",
                "examples": ["cpu_evidence_signature", "report_data_binding", "nonce_fresh", "measurement_matches_release", "release_sigstore", "gpu_nras_signature", "gpu_cc_on", "gpu_nonce_bound", "model_digest_matches_release", "tls_binding", "citation_source_digest"]
              },
              "status": { "enum": ["verified_in_browser", "verified_by_third_party", "reported", "not_checked", "failed", "not_applicable", "unverifiable"] },
              "label": { "type": "string" },
              "detail": { "type": "string" },
              "evidence_ref": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "still_trusted": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
